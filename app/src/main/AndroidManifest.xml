<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vehicle SDK: 기어, 브레이크 페달 (급제동 찾기) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <!-- Android 표준 Car API: 차량 속도 (경로 위 위치, 급제동) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <!-- NaviHelper: 회전 안내 목록, 목적지, 남은 거리·시간 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- 급제동한 곳의 위치: Pleos FusedLocation SDK, 대체로 Android 위치 -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- TextToSpeech SDK: 출발 전 예습과 1km 전 안내를 소리로 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- 내비가 화면을 덮어도 주행 중 안내와 급제동 찾기를 계속하는 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DejaRoadApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DejaRoad">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout">
            <!-- 주행 중 화면은 큰 글씨 한 장만 보여 주고 조작은 없다 (출시 시 운전자 주의 분산 심사 대상) -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RoadService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
